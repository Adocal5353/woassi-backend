APP_ENV=dev

# Values for running the API on the host (Compose Postgres is exposed on 5433).
# docker-compose.yml overrides the hosts for the api and worker containers.
DATABASE_URL=postgresql+asyncpg://woassi:woassi@localhost:5433/woassi
REDIS_URL=redis://localhost:6379/0

MINIO_ENDPOINT=localhost:9000
MINIO_PUBLIC_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=woassi
MINIO_SECRET_KEY=woassi-dev-secret
MINIO_SECURE=false
MINIO_REGION=us-east-1
MINIO_BUCKET_UPLOADS=woassi-uploads
MINIO_BUCKET_PRODUCTS=woassi-products
MINIO_BUCKET_DOCUMENTS=woassi-documents
PUBLIC_IMAGES_BASE_URL=http://localhost:9000/woassi-products

META_APP_ID=change-me
# Facebook Login for Business configuration, read by the dashboard for Embedded Signup.
META_CONFIG_ID=
META_APP_SECRET=change-me
META_VERIFY_TOKEN=change-me
META_GRAPH_VERSION=v27.0

# At least 32 characters. Generate one, see the README.
JWT_SECRET=
# Lifetimes in seconds: 15 minutes and 30 days.
JWT_ACCESS_TTL=900
JWT_REFRESH_TTL=2592000

# Fernet key used to encrypt shop secrets. Generate one, see the README.
WOASSI_ENCRYPTION_KEY=
# Key rotation: comma-separated keys, newest first. Takes precedence over WOASSI_ENCRYPTION_KEY.
WOASSI_ENCRYPTION_KEYS=

SENTRY_DSN=
# Comma-separated origins
CORS_ORIGINS=http://localhost:3000
